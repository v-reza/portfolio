# Firebase Web App credentials
# Firebase console → Project settings → General → Your apps → SDK setup and configuration.
# All of these are public by design; Firestore security rules do the protecting.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local Firestore emulator (optional). Leave empty in production.
# With this set, the project id above may be the offline "demo-portfolio" id and
# the API key / app id can stay empty:
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-portfolio
#   NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
